{
  "name": "pi-agent-frame",
  "version": "0.2.0",
  "description": "Frame a goal into a subagent roster, generated AGENT.md files, and a shared TODO.md for agentic execution.",
  "type": "module",
  "license": "MIT",
  "author": "kasp0r (https://github.com/kasp0r)",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "subagents",
    "agents",
    "scaffolding",
    "planning",
    "orchestration"
  ],
  "files": [
    "extensions",
    "lib",
    "skills",
    "prompts",
    "frame.jpeg",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:unit": "node --test test/concurrency.test.mjs test/scaffold-core.test.mjs test/execution-core.test.mjs test/extension-smoke.test.mjs test/live-acceptance.test.mjs test/write-transaction.test.mjs",
    "test:acceptance": "node scripts/live-acceptance.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "check:examples": "node examples/generate.mjs && git diff --exit-code -- examples/items-api",
    "check": "npm run typecheck && npm test && npm pack --dry-run"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "26.6.6",
    "jiti": "2.7.0",
    "pi-subagents": "0.84.0",
    "typebox": "1.3.27",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "pi": {
    "image": "frame.jpeg",
    "extensions": [
      "./extensions"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
